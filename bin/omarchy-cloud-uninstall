#!/bin/bash
#
# Remove the user-level integration created by furmware.cloud before the
# Omarchy plugin checkout itself is deleted.
#
# Provider data and live rclone credentials are deliberately preserved.
# Obsolete full-config backups created by Cloud 0.2.0 and earlier are not:
# those unnecessary credential copies are always deleted.
#
set -euo pipefail

CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"
CONFIG_DIR="$CONFIG_HOME/omarchy-cloud"
REMOTE_DIR="$CONFIG_DIR/remotes"
SETTINGS_FILE="$CONFIG_DIR/settings.conf"
UNIT_DIR="$CONFIG_HOME/systemd/user"
UNIT_NAME="omarchy-cloud-mount@.service"
LEGACY_UNIT_NAME="rclone-mount@.service"
MANAGED_MARKER="# Managed by furmware.cloud; do not edit."
BIN_DIR="$(dirname "$(realpath "${BASH_SOURCE[0]}")")"
BOOKMARK="$BIN_DIR/omarchy-cloud-bookmark"

purge=false
case "${1:-}" in
  "") ;;
  --purge) purge=true ;;
  -h|--help)
    cat <<'EOF'
Usage: omarchy-cloud-uninstall [--purge]

Stops plugin-managed mounts, removes their generated systemd user unit and
file-manager bookmarks, and leaves live rclone credentials and cloud data intact.
Obsolete credential backups created by Cloud 0.2.0 and earlier are removed.

--purge also deletes ~/.config/omarchy-cloud and ~/.cache/omarchy-cloud.
It still does not delete rclone remotes, provider credentials, cloud data, or
the rclone package. Disconnect services in the panel first to remove their
saved credentials.
EOF
    exit 0
    ;;
  *)
    echo "omarchy-cloud-uninstall: unknown option: $1" >&2
    exit 1
    ;;
esac

unit_file_is_managed() {
  local file="$1"
  [[ -f "$file" && ! -L "$file" ]] || return 1
  grep -Fqx "$MANAGED_MARKER" "$file" 2>/dev/null ||
    grep -Fq "# Generated by the Omarchy Cloud plugin." "$file" 2>/dev/null
}

require_user_manager() {
  systemctl --user show-environment >/dev/null 2>&1 || {
    echo "omarchy-cloud-uninstall: cannot contact the systemd user manager; nothing was removed" >&2
    exit 1
  }
}

unit_is_stopped_and_disabled() {
  local unit="$1" output active enabled
  if ! output="$(systemctl --user show "$unit" \
    --property=ActiveState --property=UnitFileState 2>/dev/null)"; then
    ! systemctl --user is-active --quiet "$unit" 2>/dev/null &&
      ! systemctl --user is-enabled --quiet "$unit" 2>/dev/null
    return
  fi
  active="$(awk -F= '/^ActiveState=/ {print $2}' <<<"$output")"
  enabled="$(awk -F= '/^UnitFileState=/ {print $2}' <<<"$output")"
  [[ "$active" == "inactive" || "$active" == "failed" ]] || return 1
  [[ "$enabled" != "enabled" && "$enabled" != "enabled-runtime" &&
    "$enabled" != "linked" && "$enabled" != "linked-runtime" ]]
}

valid_name() {
  [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9_-]*$ ]]
}

MOUNT_ROOT="$HOME/Cloud"
# This file is generated by the plugin. Loading it lets cleanup remove the
# exact bookmarks it created, including a customized mount root.
# shellcheck source=/dev/null
[[ -f "$SETTINGS_FILE" ]] && source "$SETTINGS_FILE"
MOUNT_ROOT="${MOUNT_ROOT/#\~/$HOME}"

declare -A remote_names=()
add_remote() {
  local name="$1"
  valid_name "$name" && remote_names["$name"]=1
}

shopt -s nullglob
for config in "$REMOTE_DIR"/*.conf; do
  [[ -f "$config" && ! -L "$config" ]] || continue
  add_remote "$(basename "$config" .conf)"
done
shopt -u nullglob

current_owned=false
legacy_owned=false
unit_file_is_managed "$UNIT_DIR/$UNIT_NAME" && current_owned=true
unit_file_is_managed "$UNIT_DIR/$LEGACY_UNIT_NAME" && legacy_owned=true
if $current_owned || $legacy_owned; then
  require_user_manager
fi

collect_unit_remotes() {
  local prefix="$1" unit name output
  output="$(systemctl --user list-units --all --type=service --plain --no-legend \
    "${prefix}*.service")" || {
    echo "omarchy-cloud-uninstall: could not inspect running $prefix services; nothing was removed" >&2
    exit 1
  }
  while IFS= read -r unit; do
    unit="${unit%%[[:space:]]*}"
    [[ "$unit" == "$prefix"*".service" ]] || continue
    name="${unit#"$prefix"}"
    name="${name%.service}"
    [[ -n "$name" ]] && add_remote "$name"
  done <<<"$output"

  output="$(systemctl --user list-unit-files --type=service --no-legend \
    "${prefix}*.service")" || {
    echo "omarchy-cloud-uninstall: could not inspect enabled $prefix services; nothing was removed" >&2
    exit 1
  }
  while IFS= read -r unit; do
    unit="${unit%%[[:space:]]*}"
    [[ "$unit" == "$prefix"*".service" ]] || continue
    name="${unit#"$prefix"}"
    name="${name%.service}"
    [[ -n "$name" ]] && add_remote "$name"
  done <<<"$output"
}

$current_owned && collect_unit_remotes "omarchy-cloud-mount@"
$legacy_owned && collect_unit_remotes "rclone-mount@"

for name in "${!remote_names[@]}"; do
  if $current_owned; then
    unit="omarchy-cloud-mount@$name.service"
    systemctl --user disable --now "$unit" >/dev/null 2>&1 || true
    unit_is_stopped_and_disabled "$unit" || {
      echo "omarchy-cloud-uninstall: could not verify that $unit stopped; nothing else was removed" >&2
      exit 1
    }
  fi
  if $legacy_owned; then
    unit="rclone-mount@$name.service"
    systemctl --user disable --now "$unit" >/dev/null 2>&1 || true
    unit_is_stopped_and_disabled "$unit" || {
      echo "omarchy-cloud-uninstall: could not verify that $unit stopped; nothing else was removed" >&2
      exit 1
    }
  fi
  if mountpoint -q "$MOUNT_ROOT/$name" 2>/dev/null; then
    echo "omarchy-cloud-uninstall: $MOUNT_ROOT/$name is still mounted; nothing else was removed" >&2
    exit 1
  fi
done

# Only after every managed unit is confirmed quiescent is it safe to remove
# bookmarks, templates, or (with --purge) the metadata needed for a retry.
for name in "${!remote_names[@]}"; do
  "$BOOKMARK" remove "$MOUNT_ROOT/$name" 2>/dev/null || true
  rmdir "$MOUNT_ROOT/$name" 2>/dev/null || true
done

$current_owned && rm -f "$UNIT_DIR/$UNIT_NAME"
$legacy_owned && rm -f "$UNIT_DIR/$LEGACY_UNIT_NAME"
if $current_owned || $legacy_owned; then
  systemctl --user daemon-reload >/dev/null
  systemctl --user reset-failed >/dev/null 2>&1 || true
fi

# Old releases copied the complete shared rclone.conf here before disconnects.
# Never leave those unrelated and supposedly deleted credentials behind.
rm -rf -- "$CONFIG_DIR/backups"

if $purge; then
  rm -rf "$CONFIG_DIR" "$CACHE_HOME/omarchy-cloud"
  echo "Removed Omarchy Cloud services, bookmarks, settings, and cache."
else
  echo "Removed Omarchy Cloud services and bookmarks."
  echo "Preserved settings/cache for reinstall; use --purge to delete them."
fi

echo "Preserved rclone remotes, credentials, the rclone package, and all cloud data."
