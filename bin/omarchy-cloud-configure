#!/bin/bash
#
# Settings for one already-connected service.
#
# Everything here is changeable after setup -- the choices made during the
# wizard are defaults, not commitments. Applying a change rewrites the
# per-remote flags and restarts that one mount; nothing else is touched.
#
set -uo pipefail

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy-cloud"
REMOTE_DIR="$CONFIG_DIR/remotes"
BIN_DIR="$(dirname "$(realpath "${BASH_SOURCE[0]}")")"
MOUNT="$BIN_DIR/omarchy-cloud-mount"

# shellcheck source=omarchy-cloud-ui.sh
source "$BIN_DIR/omarchy-cloud-ui.sh"
trap hold_open EXIT

REMOTE_NAME="${1:-}"
[[ -n "$REMOTE_NAME" ]] || { bad "usage: omarchy-cloud-configure <service>"; exit 1; }

REMOTE_TYPE="$(rclone config show "$REMOTE_NAME" 2>/dev/null | awk -F' = ' '/^type/ {print $2; exit}')"
[[ -n "$REMOTE_TYPE" ]] || { bad "No connected service called '$REMOTE_NAME'."; exit 1; }

label="$REMOTE_NAME"
extra_flags=""
# shellcheck source=/dev/null
[[ -f "$REMOTE_DIR/$REMOTE_NAME.conf" ]] && source "$REMOTE_DIR/$REMOTE_NAME.conf"

save() {
  mkdir -p "$REMOTE_DIR"
  {
    printf '# Written by omarchy-cloud-configure for the %q remote.\n' "$REMOTE_NAME"
    echo "# extra_flags is appended to the rclone mount command line."
    printf 'label=%q\n' "$label"
    printf 'extra_flags=%q\n' "$extra_flags"
  } >"$REMOTE_DIR/$REMOTE_NAME.conf"
}

# Mount flags are read at start, so a change only takes effect on a restart.
remount() {
  if "$MOUNT" is-active "$REMOTE_NAME"; then
    say "Restarting the mount so the change takes effect…"
    "$MOUNT" restart "$REMOTE_NAME"
  fi
}

# ---------------------------------------------------------------- google docs

# Kept in step with the same question in omarchy-cloud-connect.
gdocs_current() {
  case "$extra_flags" in
    *skip-gdocs*)                 echo "Hidden" ;;
    *"link.html"*)                echo "Open in Google Docs" ;;
    *export-formats*)             echo "Converted to Office files" ;;
    *)                            echo "Default" ;;
  esac
}

configure_gdocs() {
  heading "Google Docs, Sheets and Slides"
  echo "Currently: $(gdocs_current)"
  echo
  echo "Drive only stores these online, so their size is unknown until they're"
  echo "converted. That is why converting them often produces a 0-byte file."
  echo

  local choice
  choice="$(printf '%s\n' \
    "Open them in Google Docs (recommended)" \
    "Convert to Office files" \
    "Hide them" |
    gum choose --header "")" || return 0

  # Replace only the gdocs-related flags, preserving anything else set here.
  local kept
  kept="$(sed -E 's/--drive-export-formats [^ ]+//g; s/--drive-skip-gdocs//g' <<<"$extra_flags" |
    tr -s ' ' | sed 's/^ *//; s/ *$//')"

  case "$choice" in
    Hide*)    extra_flags="$kept --drive-skip-gdocs" ;;
    Convert*)
      warn "Note: these often show as 0 bytes and fail to open through a mount."
      extra_flags="$kept --drive-export-formats docx,xlsx,pptx"
      ;;
    *)        extra_flags="$kept --drive-export-formats link.html" ;;
  esac
  extra_flags="$(sed 's/^ *//; s/ *$//' <<<"$extra_flags")"

  save
  remount
  good "Saved."
}

# ---------------------------------------------------------------- other bits

configure_autostart() {
  local now="off"
  "$MOUNT" is-enabled "$REMOTE_NAME" 2>/dev/null && now="on"

  heading "Mount at login"
  echo "Currently: $now"
  echo

  if [[ "$now" == "on" ]]; then
    if gum confirm "Stop mounting this at login?"; then
      "$MOUNT" disable "$REMOTE_NAME" >/dev/null 2>&1
      good "It will no longer mount at login."
    fi
  else
    if gum confirm "Mount this automatically at login?"; then
      "$MOUNT" enable "$REMOTE_NAME" && good "It will mount at login."
    fi
  fi
}

# Google's retirement of rclone's shared credentials makes this a migration
# path, not a tuning knob: an existing connection built on the shared ID will
# stop working during 2026 and has to move to its own credentials.
credentials_current() {
  local id
  id="$(rclone config show "$REMOTE_NAME" 2>/dev/null | awk -F' = ' '/^client_id/ {print $2; exit}')"
  [[ -n "$id" ]] && echo "your own" || echo "rclone's shared (retiring during 2026)"
}

configure_credentials() {
  heading "Google credentials"
  echo "Currently: $(credentials_current)"
  echo
  echo "rclone's shared credentials stop working during 2026. Your own take"
  echo "about ten minutes to create:"
  echo "  https://rclone.org/drive/#making-your-own-client-id"
  echo

  gum confirm "Switch this service to your own credentials?" || return 0

  local id secret
  id="$(gum input --placeholder "client ID (ends in .apps.googleusercontent.com)" --width 70)" || return 0
  secret="$(gum input --password --placeholder "client secret")" || return 0
  [[ -n "$id" && -n "$secret" ]] || { bad "Both values are needed."; return 0; }

  rclone config update "$REMOTE_NAME" "client_id=$id" "client_secret=$secret" >/dev/null || {
    bad "Could not save the credentials."
    return 0
  }

  # New credentials mean the old token is worthless -- it was issued to the
  # previous client. Signing in again is required, not optional.
  say "Credentials saved. Signing in again with them…"
  echo
  if rclone config update "$REMOTE_NAME" --no-output; then
    remount
    good "Done."
  else
    bad "Sign-in did not complete. The service may not work until it does."
  fi
}

configure_flags() {
  heading "Extra rclone flags"
  echo "Appended to the mount command. Leave empty for none."
  echo "Reference: https://rclone.org/${REMOTE_TYPE}/"
  echo

  local entered
  entered="$(gum input --value "$extra_flags" --width 70 --placeholder "--flag value")" || return 0
  extra_flags="$entered"
  save
  remount
  good "Saved."
}

disconnect_service() {
  heading "Disconnect $label"
  echo "This unmounts it, deletes the saved sign-in, and removes its bookmark."
  echo "Nothing stored in the cloud is deleted."
  echo

  # --default=false matters here: gum confirm otherwise defaults to Yes, so
  # landing on this entry and pressing enter would disconnect a working
  # service. Destructive actions default to the safe answer.
  gum confirm --default=false "Disconnect $label?" || return 0
  "$MOUNT" forget "$REMOTE_NAME" --yes
  good "Disconnected."
  exit 0
}

# ---------------------------------------------------------------- menu

main() {
  while true; do
    title "$label settings"

    local -a options=()
    if [[ "$REMOTE_TYPE" == "drive" ]]; then
      options+=("Google Docs handling — $(gdocs_current)")
      options+=("Google credentials — $(credentials_current)")
    fi
    options+=("Mount at login")
    options+=("Extra rclone flags")
    options+=("Disconnect this service")
    options+=("Close")

    local choice
    choice="$(printf '%s\n' "${options[@]}" | gum choose --header "")" || exit 0

    case "$choice" in
      "Google Docs handling"*)   configure_gdocs ;;
      "Google credentials"*)     configure_credentials ;;
      "Mount at login")          configure_autostart ;;
      "Extra rclone flags")      configure_flags ;;
      "Disconnect this service") disconnect_service ;;
      *)                         exit 0 ;;
    esac
  done
}

main "$@"
