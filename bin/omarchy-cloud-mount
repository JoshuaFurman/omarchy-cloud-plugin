#!/bin/bash
#
# Mount lifecycle for the Omarchy Cloud plugin.
#
# The shell plugin never runs `rclone mount` itself -- if it did, every
# `omarchy restart shell` (and every plugin hot-reload while developing) would
# yank the mounts out from under whatever has files open. systemd supervises
# the mounts; this script is the seam between the two, and everything it does
# is runnable by hand:
#
#   omarchy-cloud-mount run gdrive       # exactly what systemd executes
#   omarchy-cloud-mount enable gdrive    # mount now + at login
#   omarchy-cloud-mount status
#
set -euo pipefail

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy-cloud"
REMOTE_DIR="$CONFIG_DIR/remotes"
SETTINGS_FILE="$CONFIG_DIR/settings.conf"
UNIT_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
UNIT_NAME="omarchy-cloud-mount@.service"
LEGACY_UNIT_NAME="rclone-mount@.service"
CACHE_ROOT="${XDG_CACHE_HOME:-$HOME/.cache}/omarchy-cloud"
MANAGED_MARKER="# Managed by furmware.cloud; do not edit."
SELF="$(realpath "${BASH_SOURCE[0]}")"

# Defaults, overridden by settings.conf, which the plugin rewrites whenever its
# settings change. systemd starts units at login with no idea what shell.json
# says, so this has to live on disk rather than being passed in.
MOUNT_ROOT="$HOME/Cloud"
VFS_CACHE_MODE="full"
CACHE_MAX_SIZE_GB="8"

load_settings() {
  # shellcheck source=/dev/null
  [[ -f "$SETTINGS_FILE" ]] && source "$SETTINGS_FILE"
  MOUNT_ROOT="${MOUNT_ROOT/#\~/$HOME}"
}

die() {
  echo "omarchy-cloud-mount: $*" >&2
  exit 1
}

unit_file_is_managed() {
  local file="$1"
  [[ -f "$file" && ! -L "$file" ]] || return 1
  grep -Fqx "$MANAGED_MARKER" "$file" 2>/dev/null ||
    grep -Fq "# Generated by the Omarchy Cloud plugin." "$file" 2>/dev/null
}

refuse_foreign_unit() {
  local file="$UNIT_DIR/$UNIT_NAME"
  [[ ! -e "$file" && ! -L "$file" ]] || unit_file_is_managed "$file" ||
    die "refusing to overwrite an existing unit not owned by furmware.cloud: $file"
}

require_rclone() {
  command -v rclone >/dev/null 2>&1 ||
    die "rclone is not installed. Run: omarchy pkg add rclone"
}

valid_name() {
  # Remote names become systemd instance names and directory names; keep them
  # boring so neither has to be escaped.
  [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9_-]*$ ]]
}

remote_exists() {
  require_rclone
  rclone listremotes 2>/dev/null | grep -qx "$1:"
}

remote_is_managed() {
  local file="$REMOTE_DIR/$1.conf"
  [[ -f "$file" && ! -L "$file" ]]
}

require_managed_remote() {
  remote_is_managed "$1" ||
    die "refusing to manage '$1': it has no furmware.cloud ownership record"
}

rclone_config_path() {
  local output path
  output="$(rclone config file 2>/dev/null)" ||
    die "could not locate rclone's configuration file"
  path="$(sed '/^[[:space:]]*$/d' <<<"$output" | tail -n 1)"
  [[ -n "$path" ]] || die "rclone returned an empty configuration path"
  printf '%s\n' "$path"
}

# Versions through 0.2.0 copied the complete shared rclone.conf before a
# disconnect. Those copies retained both the disconnected remote's secrets and
# credentials for unrelated remotes. They have no safe purpose, so remove them
# on the first invocation after an upgrade and never create them again.
purge_legacy_credential_backups() {
  local backup_dir="$CONFIG_DIR/backups"
  [[ ! -e "$backup_dir" && ! -L "$backup_dir" ]] || rm -rf -- "$backup_dir"
}

purge_legacy_credential_backups

# ---------------------------------------------------------------- settings

cmd_settings() {
  local tmp
  mkdir -p "$CONFIG_DIR"
  load_settings

  for pair in "$@"; do
    local key="${pair%%=*}" value="${pair#*=}"
    case "$key" in
      MOUNT_ROOT|VFS_CACHE_MODE|CACHE_MAX_SIZE_GB) printf -v "$key" '%s' "$value" ;;
      *) die "unknown setting: $key" ;;
    esac
  done

  tmp="$(mktemp "$CONFIG_DIR/.settings.conf.XXXXXX")"
  {
    echo "# Written by the Omarchy Cloud plugin. Edits here are overwritten when the"
    echo "# plugin's settings change; change them in the plugin instead."
    printf 'MOUNT_ROOT=%q\n' "$MOUNT_ROOT"
    printf 'VFS_CACHE_MODE=%q\n' "$VFS_CACHE_MODE"
    printf 'CACHE_MAX_SIZE_GB=%q\n' "$CACHE_MAX_SIZE_GB"
  } >"$tmp"
  chmod 600 "$tmp"
  mv "$tmp" "$SETTINGS_FILE"
  return 0
}

# ---------------------------------------------------------------- unit file

managed_remote_names() {
  local config name
  shopt -s nullglob
  for config in "$REMOTE_DIR"/*.conf; do
    [[ -f "$config" && ! -L "$config" ]] || continue
    name="$(basename "$config" .conf)"
    valid_name "$name" && printf '%s\n' "$name"
  done
  shopt -u nullglob
}

# Versions before 0.2 used the generic rclone-mount@ name. Migrate only a
# template carrying this plugin's marker, and only when a user explicitly
# starts, enables, or restarts a mount. Merely enabling the shell plugin never
# replaces an existing user unit.
migrate_legacy_unit() {
  local legacy_file="$UNIT_DIR/$LEGACY_UNIT_NAME"
  unit_file_is_managed "$legacy_file" || return 0
  require_user_manager

  local name old_unit
  local -a names=() enabled_names=() active_names=()
  while IFS= read -r name; do
    [[ -n "$name" ]] || continue
    names+=("$name")
    old_unit="rclone-mount@$name.service"
    systemctl --user is-enabled --quiet "$old_unit" 2>/dev/null && enabled_names+=("$name")
    systemctl --user is-active --quiet "$old_unit" 2>/dev/null && active_names+=("$name")
  done < <(managed_remote_names)

  for name in "${names[@]}"; do
    old_unit="rclone-mount@$name.service"
    systemctl --user disable --now "$old_unit" >/dev/null 2>&1 || true
    if ! unit_is_stopped_and_disabled "$old_unit"; then
      # Keep the legacy template and restore the state already observed. A
      # later retry can then migrate without forgetting which mounts belonged
      # at login or were running before the attempt.
      for name in "${enabled_names[@]}"; do
        systemctl --user enable "rclone-mount@$name.service" >/dev/null 2>&1 || true
      done
      for name in "${active_names[@]}"; do
        systemctl --user start "rclone-mount@$name.service" >/dev/null 2>&1 || true
      done
      die "could not safely stop $old_unit; the legacy unit was kept"
    fi
  done

  rm -f "$legacy_file"
  systemctl --user daemon-reload
  for name in "${enabled_names[@]}"; do
    systemctl --user enable "omarchy-cloud-mount@$name.service" >/dev/null
  done
  for name in "${active_names[@]}"; do
    systemctl --user start "omarchy-cloud-mount@$name.service"
  done
  echo "Migrated the legacy $LEGACY_UNIT_NAME unit."
}

systemd_quote() {
  local value="$1"
  value="${value//\\/\\\\}"
  value="${value//\"/\\\"}"
  value="${value//%/%%}"
  printf '"%s"' "$value"
}

cmd_install_unit() {
  mkdir -p "$UNIT_DIR"
  refuse_foreign_unit

  local unit_file="$UNIT_DIR/$UNIT_NAME" quoted_self tmp
  quoted_self="$(systemd_quote "$SELF")"
  tmp="$(mktemp "$UNIT_DIR/.${UNIT_NAME}.XXXXXX")"
  cat >"$tmp" <<EOF
$MANAGED_MARKER
# Regenerate with the plugin's bin/omarchy-cloud-mount install-unit command.
[Unit]
Description=Omarchy Cloud mount for %i (rclone)
Documentation=https://rclone.org/commands/rclone_mount/
After=network-online.target

[Service]
# rclone speaks sd_notify, so the unit only reaches "active" once the
# mountpoint is genuinely usable -- the panel is not left claiming a mount is
# ready while it is still being set up.
Type=notify
ExecStart=$quoted_self run %i
# SIGTERM normally unmounts cleanly. The post-stop helper only detaches a stale
# FUSE mount left by a crash and reads the current mount root at that moment.
ExecStopPost=$quoted_self cleanup %i
Restart=on-failure
RestartSec=10
TimeoutStopSec=30

[Install]
WantedBy=default.target
EOF
  chmod 644 "$tmp"
  mv "$tmp" "$unit_file"
  systemctl --user daemon-reload
  migrate_legacy_unit
  echo "Installed $unit_file"
}

# ---------------------------------------------------------------- the mount

# Executed by systemd. Uses exec so the PID systemd watches is rclone's own,
# which is what keeps Type=notify working through this wrapper.
cmd_run() {
  local name="${1:-}"
  [[ -n "$name" ]] || die "usage: omarchy-cloud-mount run <remote>"
  valid_name "$name" || die "invalid remote name: $name"
  require_managed_remote "$name"
  require_rclone
  load_settings

  local extra_flags="" rclone_config
  # shellcheck source=/dev/null
  [[ -f "$REMOTE_DIR/$name.conf" ]] && source "$REMOTE_DIR/$name.conf"
  rclone_config="$(rclone_config_path)"

  local mount_point="$MOUNT_ROOT/$name"
  mkdir -p "$mount_point"

  # A previous crash can leave the mountpoint attached but dead, which makes
  # rclone refuse to mount and Nautilus report "Transport endpoint is not
  # connected". Clearing it is safe: a live mount is never lazily detached
  # here because systemd stopped the old unit before starting this one.
  if ! mountpoint -q "$mount_point" 2>/dev/null; then
    fusermount3 -uz "$mount_point" 2>/dev/null || true
  fi

  local -a args=(
    mount "$name:" "$mount_point"
    --config "$rclone_config"
    --cache-dir "$CACHE_ROOT/rclone"
    --vfs-cache-mode "$VFS_CACHE_MODE"
    --vfs-cache-max-size "${CACHE_MAX_SIZE_GB}G"
    --vfs-cache-max-age 168h
    --dir-cache-time 72h
    --poll-interval 1m
    --umask 077
    --log-level INFO
  )

  # Per-remote flags, e.g. Google Docs export formats. Word-split on purpose;
  # the wizard only ever writes flags without embedded spaces.
  if [[ -n "$extra_flags" ]]; then
    read -ra split <<<"$extra_flags"
    args+=("${split[@]}")
  fi

  exec rclone "${args[@]}"
}

# Called by ExecStopPost after rclone exits. It is deliberately idempotent.
cmd_cleanup() {
  local name="${1:-}"
  [[ -n "$name" ]] || die "usage: omarchy-cloud-mount cleanup <remote>"
  valid_name "$name" || die "invalid remote name: $name"
  load_settings
  local mount_point="$MOUNT_ROOT/$name"
  if mountpoint -q "$mount_point" 2>/dev/null; then
    fusermount3 -uz "$mount_point" 2>/dev/null || true
  fi
}

# ---------------------------------------------------------------- control

unit_for() { echo "omarchy-cloud-mount@$1.service"; }
legacy_unit_for() { echo "rclone-mount@$1.service"; }

legacy_unit_is_managed() {
  unit_file_is_managed "$UNIT_DIR/$LEGACY_UNIT_NAME"
}

require_user_manager() {
  systemctl --user show-environment >/dev/null 2>&1 ||
    die "cannot contact the systemd user manager; no mount state was changed"
}

unit_is_stopped() {
  local unit="$1" output active
  if ! output="$(systemctl --user show "$unit" --property=ActiveState 2>/dev/null)"; then
    # A namespaced instance that is neither loaded nor installed is already
    # stopped. The user manager itself was checked immediately beforehand.
    ! systemctl --user is-active --quiet "$unit" 2>/dev/null
    return
  fi
  active="${output#ActiveState=}"
  [[ "$active" == "inactive" || "$active" == "failed" ]]
}

unit_is_stopped_and_disabled() {
  local unit="$1" output active enabled
  if ! output="$(systemctl --user show "$unit" \
    --property=ActiveState --property=UnitFileState 2>/dev/null)"; then
    ! systemctl --user is-active --quiet "$unit" 2>/dev/null &&
      ! systemctl --user is-enabled --quiet "$unit" 2>/dev/null
    return
  fi
  active="$(awk -F= '/^ActiveState=/ {print $2}' <<<"$output")"
  enabled="$(awk -F= '/^UnitFileState=/ {print $2}' <<<"$output")"
  [[ "$active" == "inactive" || "$active" == "failed" ]] || return 1
  [[ "$enabled" != "enabled" && "$enabled" != "enabled-runtime" &&
    "$enabled" != "linked" && "$enabled" != "linked-runtime" ]]
}

ensure_unit() {
  refuse_foreign_unit
  if [[ ! -f "$UNIT_DIR/$UNIT_NAME" ]]; then
    cmd_install_unit >/dev/null
  else
    migrate_legacy_unit >/dev/null
  fi
}

cmd_is_active() {
  local name="${1:?usage: omarchy-cloud-mount is-active <remote>}"
  if [[ -f "$UNIT_DIR/$UNIT_NAME" ]] && unit_file_is_managed "$UNIT_DIR/$UNIT_NAME" &&
      systemctl --user is-active --quiet "$(unit_for "$name")" 2>/dev/null; then
    return 0
  fi
  legacy_unit_is_managed &&
    systemctl --user is-active --quiet "$(legacy_unit_for "$name")" 2>/dev/null
}

cmd_is_enabled() {
  local name="${1:?usage: omarchy-cloud-mount is-enabled <remote>}"
  if [[ -f "$UNIT_DIR/$UNIT_NAME" ]] && unit_file_is_managed "$UNIT_DIR/$UNIT_NAME" &&
      systemctl --user is-enabled --quiet "$(unit_for "$name")" 2>/dev/null; then
    return 0
  fi
  legacy_unit_is_managed &&
    systemctl --user is-enabled --quiet "$(legacy_unit_for "$name")" 2>/dev/null
}

cmd_enable() {
  local name="${1:?usage: omarchy-cloud-mount enable <remote>}"
  valid_name "$name" || die "invalid remote name: $name"
  require_managed_remote "$name"
  remote_exists "$name" || die "no such remote: $name"
  ensure_unit
  systemctl --user enable --now "$(unit_for "$name")"
}

cmd_disable() {
  local name="${1:?usage: omarchy-cloud-mount disable <remote>}"
  valid_name "$name" || die "invalid remote name: $name"
  require_managed_remote "$name"
  refuse_foreign_unit
  require_user_manager
  local unit
  unit="$(unit_for "$name")"
  systemctl --user disable --now "$unit" >/dev/null 2>&1 || true
  unit_is_stopped_and_disabled "$unit" ||
    die "could not verify that $unit is stopped and disabled"
  if legacy_unit_is_managed; then
    unit="$(legacy_unit_for "$name")"
    systemctl --user disable --now "$unit" >/dev/null 2>&1 || true
    unit_is_stopped_and_disabled "$unit" ||
      die "could not verify that $unit is stopped and disabled"
  fi
}

cmd_start() {
  local name="${1:?usage: omarchy-cloud-mount start <remote>}"
  valid_name "$name" || die "invalid remote name: $name"
  require_managed_remote "$name"
  remote_exists "$name" || die "no such remote: $name"
  ensure_unit
  systemctl --user start "$(unit_for "$name")"
}

cmd_stop() {
  local name="${1:?usage: omarchy-cloud-mount stop <remote>}"
  valid_name "$name" || die "invalid remote name: $name"
  require_managed_remote "$name"
  refuse_foreign_unit
  require_user_manager
  local unit
  unit="$(unit_for "$name")"
  systemctl --user stop "$unit" >/dev/null 2>&1 || true
  unit_is_stopped "$unit" || die "could not verify that $unit is stopped"
  if legacy_unit_is_managed; then
    unit="$(legacy_unit_for "$name")"
    systemctl --user stop "$unit" >/dev/null 2>&1 || true
    unit_is_stopped "$unit" || die "could not verify that $unit is stopped"
  fi
}

cmd_restart() {
  local name="${1:?usage: omarchy-cloud-mount restart <remote>}"
  valid_name "$name" || die "invalid remote name: $name"
  require_managed_remote "$name"
  cmd_is_active "$name" || return 0
  remote_exists "$name" || die "no such remote: $name"
  ensure_unit
  systemctl --user restart "$(unit_for "$name")"
}

cmd_toggle() {
  local name="${1:?usage: omarchy-cloud-mount toggle <remote>}"
  if cmd_is_active "$name"; then
    cmd_stop "$name"
  else
    cmd_start "$name"
  fi
}

# Removing a service is the one destructive action here, so it names exactly
# what it is about to do and requires an explicit --yes from the caller.
cmd_forget() {
  local name="${1:?usage: omarchy-cloud-mount forget <remote> --yes}"
  local confirm="${2:-}"
  valid_name "$name" || die "invalid remote name: $name"
  require_managed_remote "$name"
  load_settings

  if [[ "$confirm" != "--yes" ]]; then
    echo "This will disconnect '$name':"
    echo "  - unmount and disable $MOUNT_ROOT/$name"
    echo "  - delete the rclone remote and its stored credentials"
    echo "  - remove its file manager bookmark"
    echo "Nothing in the cloud is deleted. Re-run with --yes to confirm."
    return 1
  fi

  # Stop the mount before changing rclone's config, then ask rclone to remove
  # only this remote's section. Do not copy the shared config: that would retain
  # this token and every unrelated remote's credentials outside rclone.conf.
  require_rclone
  cmd_disable "$name"
  if mountpoint -q "$MOUNT_ROOT/$name" 2>/dev/null; then
    die "the mount at '$MOUNT_ROOT/$name' is still active; credentials and metadata were kept"
  fi

  local remotes
  if ! remotes="$(rclone listremotes 2>/dev/null)"; then
    die "could not read rclone's remote list; credentials and metadata were kept"
  fi
  if grep -Fqx "$name:" <<<"$remotes"; then
    if ! rclone config delete "$name" >/dev/null; then
      die "could not delete rclone remote '$name'; its credentials may still be saved"
    fi
  fi

  # Do not claim success or remove the ownership record unless the credential
  # deletion can be verified. Keeping the record lets the user retry safely.
  if ! remotes="$(rclone listremotes 2>/dev/null)"; then
    die "could not verify deletion of rclone remote '$name'; plugin metadata was kept"
  fi
  if grep -Fqx "$name:" <<<"$remotes"; then
    die "rclone remote '$name' still exists; plugin metadata was kept"
  fi

  "$(dirname "$SELF")/omarchy-cloud-bookmark" remove "$MOUNT_ROOT/$name" 2>/dev/null || true
  rm -f "$REMOTE_DIR/$name.conf"
  rmdir "$MOUNT_ROOT/$name" 2>/dev/null || true
  echo "Disconnected $name."
}

cmd_status() {
  load_settings
  "$(dirname "$SELF")/omarchy-cloud-status" --root "$MOUNT_ROOT" "$@"
}

# ---------------------------------------------------------------- dispatch

case "${1:-}" in
  run)          shift; cmd_run "$@" ;;
  cleanup)      shift; cmd_cleanup "$@" ;;
  install-unit) shift; cmd_install_unit "$@" ;;
  settings)     shift; cmd_settings "$@" ;;
  enable)       shift; cmd_enable "$@" ;;
  disable)      shift; cmd_disable "$@" ;;
  start)        shift; cmd_start "$@" ;;
  stop)         shift; cmd_stop "$@" ;;
  restart)      shift; cmd_restart "$@" ;;
  is-active)    shift; cmd_is_active "$@" ;;
  is-enabled)   shift; cmd_is_enabled "$@" ;;
  toggle)       shift; cmd_toggle "$@" ;;
  forget)       shift; cmd_forget "$@" ;;
  status)       shift; cmd_status "$@" ;;
  *)
    cat <<'EOF'
Usage: omarchy-cloud-mount <command> [args]

  run <remote>            Mount in the foreground (what systemd executes)
  install-unit            Write and reload the systemd user template unit
  settings KEY=VALUE...   Persist MOUNT_ROOT, VFS_CACHE_MODE, CACHE_MAX_SIZE_GB
  enable <remote>         Mount now and at every login
  disable <remote>        Unmount and stop mounting at login
  start|stop|restart <r>  Control a mount for this session
  toggle <remote>         Toggle a mount for this session
  forget <remote> --yes   Disconnect a service and delete its credentials
  status [--with-quota]   Print JSON state for all remotes
EOF
    exit 1
    ;;
esac
